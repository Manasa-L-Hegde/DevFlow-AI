# DevFlow AI Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# =============================================================================
# Groq API Configuration
# =============================================================================
# Get your free API key at: https://console.groq.com/keys
# Format: gsk_ followed by 52 alphanumeric characters
GROQ_API_KEY=gsk_your_groq_api_key_here

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite database file path (relative to project root)
DATABASE_URL=sqlite:///devflow.db

# =============================================================================
# Application Settings
# =============================================================================
# Application name displayed in the UI
APP_NAME=DevFlow AI

# Debug mode (set to False in production)
DEBUG=True

# =============================================================================
# Optional: Streamlit Configuration
# =============================================================================
# These are typically set by the deployment platform
# Uncomment and modify if needed for local development

# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
# STREAMLIT_SERVER_HEADLESS=false
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# =============================================================================
# Security Notes
# =============================================================================
# 1. Never commit .env files to git
# 2. Rotate API keys regularly
# 3. Use platform secrets management in production (Streamlit Secrets, etc.)
# 4. Keep DEBUG=False in production environments
# 5. Monitor API usage to prevent unexpected charges